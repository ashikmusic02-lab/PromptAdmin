{
  "entities": {
    "PromptImage": {
      "title": "PromptImage",
      "description": "Public AI Photo Inspiration metadata managed strictly via direct external image URL (does not expose the protected generation prompt).",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "description": "Direct external image URL (.jpg, .jpeg, .png, .webp)" },
        "shortName": { "type": "string", "description": "Image short identifier slug" },
        "title": { "type": "string", "description": "Display title of the inspiration image" },
        "description": { "type": "string", "description": "Detailed description and style notes" },
        "categoryId": { "type": "string", "description": "Foreign key to categories collection" },
        "categoryName": { "type": "string", "description": "Denormalized category name" },
        "featured": { "type": "boolean", "description": "Whether highlighted in Featured carousel" },
        "trending": { "type": "boolean", "description": "Whether highlighted in Trending section" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT"], "description": "Publication state" },
        "displayOrder": { "type": "integer", "description": "Numeric sort priority" },
        "deepLink": { "type": "string", "description": "Auto-generated internal app destination" },
        "viewsCount": { "type": "integer" },
        "uniqueViewsCount": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "promptUnlocksCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "createdByUid": { "type": "string" }
      },
      "required": ["imageUrl", "shortName", "title", "categoryId", "status", "displayOrder", "deepLink"]
    },
    "ImagePromptSecret": {
      "title": "ImagePromptSecret",
      "description": "Protected AI generation prompt stored separately in /imagePrompts/{imageId}, readable only by staff or users with a promptUnlocks/{uid}_{imageId} record.",
      "type": "object",
      "properties": {
        "imageId": { "type": "string" },
        "prompt": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAtMillis": { "type": "integer" }
      },
      "required": ["imageId", "prompt"]
    },
    "PromptCategory": {
      "title": "PromptCategory",
      "description": "Category for organizing AI photo prompts using direct external thumbnail URLs.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "displayOrder": { "type": "integer" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "thumbnailUrl", "displayOrder", "active"]
    },
    "AppUserRecord": {
      "title": "AppUserRecord",
      "description": "Registered user of the separate Android User Application.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "DISABLED", "FLAGGED"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "unlocksCount": { "type": "integer" },
        "reportedCount": { "type": "integer" }
      },
      "required": ["username", "accountStatus"]
    },
    "ImageComment": {
      "title": "ImageComment",
      "description": "User comment on an image (user creates must have moderationStatus == 'PENDING').",
      "type": "object",
      "properties": {
        "imageId": { "type": "string" },
        "imageTitle": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "content": { "type": "string" },
        "moderationStatus": { "type": "string", "enum": ["APPROVED", "PENDING", "HIDDEN", "DELETED"] },
        "reported": { "type": "boolean" },
        "reportReason": { "type": "string" },
        "adminReply": { "type": "string" },
        "moderatedByEmail": { "type": "string" }
      },
      "required": ["imageId", "userId", "username", "content", "moderationStatus"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Immutable administrator activity log entry requiring actorUid == request.auth.uid.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminRole": { "type": "string" },
        "actionType": { "type": "string" },
        "targetEntity": { "type": "string" },
        "summary": { "type": "string" },
        "createdAtMillis": { "type": "integer" }
      },
      "required": ["actorUid", "adminEmail", "actionType", "targetEntity", "summary"]
    }
  },
  "firestore": {
    "/images/{imageId}": { "schema": { "$ref": "#/entities/PromptImage" }, "description": "Public image metadata (no prompt field)" },
    "/imagePrompts/{imageId}": { "schema": { "$ref": "#/entities/ImagePromptSecret" }, "description": "Protected generation prompts readable only by staff or unlocked users" },
    "/categories/{categoryId}": { "schema": { "$ref": "#/entities/PromptCategory" }, "description": "Image categories" },
    "/users/{userId}": { "schema": { "$ref": "#/entities/AppUserRecord" }, "description": "User application accounts" },
    "/comments/{commentId}": { "schema": { "$ref": "#/entities/ImageComment" }, "description": "Moderated user comments" },
    "/adminActivityLogs/{logId}": { "schema": { "$ref": "#/entities/AdminActivityLog" }, "description": "Immutable admin audit logs" }
  }
}
