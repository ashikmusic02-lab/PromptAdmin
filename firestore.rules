rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS: GOOGLE SIGN-IN ALLOWLIST AUTHORIZATION
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwnerEmail() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sfforhadvai@gmail.com'];
    }

    function isOwner() {
      return isOwnerEmail();
    }

    function isAdminOrOwner() {
      return isOwnerEmail();
    }

    function isStaff() {
      return isOwnerEmail();
    }

    function isValidDirectImageUrl(url) {
      return url is string
        && url.size() >= 12
        && url.size() <= 2048
        && url.matches('^https?://.*');
    }

    // Checks whether an authenticated user has a server-issued promptUnlocks record
    // with deterministic ID `${userId}_${imageId}`
    function hasPromptUnlock(imageId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/promptUnlocks/$(request.auth.uid + '_' + imageId));
    }

    // =========================================================================
    // 1. IMAGES COLLECTION (Public Metadata Only — NO "prompt" field)
    // =========================================================================
    match /images/{imageId} {
      // Public user app reads only PUBLISHED images; Staff reads all (including DRAFT)
      allow read: if (resource.data.status == 'PUBLISHED') || isStaff();
      // The "prompt" field is prohibited in /images/{imageId} so normal users cannot read it;
      // prompts are stored exclusively in /imagePrompts/{imageId}.
      allow create, update: if isAdminOrOwner()
        && !('prompt' in request.resource.data)
        && isValidDirectImageUrl(request.resource.data.imageUrl)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.shortName is string
        && request.resource.data.status in ['PUBLISHED', 'DRAFT']
        && request.resource.data.deepLink is string;
      allow delete: if isAdminOrOwner();
    }

    // =========================================================================
    // 1B. IMAGE PROMPTS COLLECTION (Protected Prompts — Staff or Unlocked Users)
    // =========================================================================
    match /imagePrompts/{imageId} {
      allow read: if isStaff() || hasPromptUnlock(imageId);
      allow create, update: if isAdminOrOwner()
        && request.resource.data.imageId == imageId
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0;
      allow delete: if isAdminOrOwner();
    }

    // =========================================================================
    // 2. CATEGORIES COLLECTION
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if (resource.data.active == true) || isStaff();
      allow create, update: if isAdminOrOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && isValidDirectImageUrl(request.resource.data.thumbnailUrl);
      allow delete: if isAdminOrOwner();
    }

    // =========================================================================
    // 3. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow read: if isStaff() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdminOrOwner();
      allow update: if isAdminOrOwner() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isOwner();
    }

    // =========================================================================
    // 4. COMMENTS COLLECTION (Create Forces moderationStatus == 'PENDING')
    // =========================================================================
    match /comments/{commentId} {
      allow read: if (resource.data.moderationStatus == 'APPROVED') || isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.moderationStatus == 'PENDING'
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // 5. LIKES, FAVORITES, PROMPT UNLOCKS & REPORTS
    // =========================================================================
    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdminOrOwner();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdminOrOwner();
    }

    match /favorites/{favoriteId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /promptUnlocks/{unlockId} {
      // Normal users cannot create promptUnlocks directly (issued only by trusted backend / staff)
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdminOrOwner();
    }

    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // 6. GOOGLE ADMOB SETTINGS & APP CONTENT SETTINGS
    // =========================================================================
    match /advertisementSettings/{configId} {
      allow read: if true;
      allow write: if isAdminOrOwner();
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdminOrOwner();
    }

    // =========================================================================
    // 7. ONESIGNAL NOTIFICATIONS & NOTIFICATION HISTORY
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create, update: if isAdminOrOwner()
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.deepLink is string;
      allow delete: if isOwner();
    }

    // =========================================================================
    // 8. ADMINISTRATOR ACCOUNTS & ACTIVITY LOGS
    // =========================================================================
    match /adminUsers/{adminId} {
      allow read, write: if isOwnerEmail();
    }

    match /adminActivityLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
